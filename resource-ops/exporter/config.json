{
  "bridge_version": 1,
  "description": "AI 自助资源运营体系 · 公开数据桥配置（方案书 §6.7 白名单 DTO 落地）",

  "base": {
    "app_token_env": "FEISHU_BASE_TOKEN",
    "app_id_env": "FEISHU_APP_ID",
    "app_secret_env": "FEISHU_APP_SECRET",
    "host": "open.feishu.cn",
    "export_view": "AI 公开导出"
  },

  "fuzz": {
    "额度状态": {
      "description": "剩余额度模糊化区间（不公开精确额度）。由 剩余额度快照/额度总量/安全余量 三字段计算得出，随后三个原始数值被丢弃。",
      "from": ["剩余额度快照", "额度总量", "安全余量"],
      "bands": [
        {"name": "耗尽", "rule": "剩余<=0 或 状态=额度耗尽"},
        {"name": "接近安全余量", "rule": "剩余<=安全余量"},
        {"name": "偏低(<20%)", "rule": "剩余/总量 < 0.2"},
        {"name": "中等(20-50%)", "rule": "剩余/总量 < 0.5"},
        {"name": "充足(>50%)", "rule": "其余（有总量口径）"},
        {"name": "未知", "rule": "缺少总量口径或剩余值"}
      ]
    }
  },

  "tables": {
    "资源能力规格表": {
      "slug": "capabilities",
      "primary_key": "capability_id",
      "whitelist": [
        "capability_id", "资源名称", "类别", "逻辑模型", "质量等级", "调用方式",
        "adapter_id", "协议版本", "模型族", "请求模板版本",
        "endpoint", "路由组", "认证方案", "状态"
      ],
      "drop": ["实例列表"],
      "fuzz": {},
      "classifications": {
        "PUBLIC": [
          "capability_id", "资源名称", "类别", "逻辑模型", "质量等级",
          "协议版本", "模型族", "请求模板版本", "调用方式", "adapter_id",
          "endpoint", "路由组", "认证方案", "状态"
        ],
        "PUBLIC_COARSE": [],
        "INTERNAL": ["允许主机", "请求体模板",
                     "健康探测", "免费额度描述", "实例列表"],
        "SECRET": ["凭证ID", "需人工登录URL", "缺失环境变量", "验证指纹",
                   "密钥", "密码", "app_token", "app_secret", "credential"]
      }
    },
    "资源实例表": {
      "slug": "instances",
      "primary_key": "instance_id",
      "whitelist": [
        "instance_id", "平台", "实际模型名", "额度单位", "重置规则",
        "配置版本", "所属能力",
        "路由优先级", "限速", "状态"
      ],
      "drop": [
        "额度总量", "剩余额度快照", "安全余量",
        "需人工登录URL", "缺失环境变量", "验证指纹", "凭证ID", "任务列表",
        "额度重置日", "额度到期日", "验证策略", "上次验证",
        "下次验证", "备注"
      ],
      "fuzz": {
        "额度状态": {
          "from": ["剩余额度快照", "额度总量", "安全余量"]
        }
      },
      "classifications": {
        "PUBLIC": [
          "instance_id", "平台", "实际模型名", "额度单位", "重置规则",
          "配置版本", "所属能力",
          "路由优先级", "限速", "状态"
        ],
        "PUBLIC_COARSE": ["额度状态"],
        "INTERNAL": ["剩余额度快照", "额度总量", "安全余量",
                     "额度重置日", "额度到期日", "验证策略",
                     "上次验证", "下次验证", "备注", "任务列表"],
        "SECRET": ["凭证ID", "需人工登录URL", "缺失环境变量", "验证指纹",
                   "密钥", "密码", "app_token", "app_secret", "credential"]
      }
    }
  },

  "scan": {
    "description": "公开产物敏感扫描（git 历史不可逆，扫描失败即中止部署）。",
    "patterns": [
      "app_token[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9]{15,}",
      "tbl[a-zA-Z0-9]{6,}",
      "cli_[a-zA-Z0-9]{8,}",
      "(api[_-]?key|secret|access[_-]?token|bearer)[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9_\\-]{8,}",
      "credential_id[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9_\\-]{6,}"
    ]
  }
}
